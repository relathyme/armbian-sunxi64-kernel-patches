#!/bin/sh

set -e

mount -t sysfs sysfs -o nosuid,nodev,noexec /sys
mount -t configfs configfs -o nosuid,nodev,noexec /sys/kernel/config
mount -t proc proc -o nosuid,nodev,noexec /proc

skip_overlay=$(cat /sys/bus/nvmem/devices/mtd1/cells/conf_skip_overlay* || printf 0)
force_ram=$(cat /sys/bus/nvmem/devices/mtd1/cells/conf_force_ram* || printf 0)
skip_gadget=$(cat /sys/bus/nvmem/devices/mtd1/cells/conf_skip_gadget* || printf 0)

if [ "$skip_overlay" != 1 ]; then
	if findfs LABEL=persist && [ "$force_ram" != 1 ]; then
		mount -t ext4 LABEL=persist -o defaults,noatime,nodiratime,discard /mnt/overlay
	else
		mount -t tmpfs tmpfs -o defaults,size=1G /mnt/overlay
	fi
	mkdir -p /mnt/overlay/upper /mnt/overlay/work /mnt/overlay/merged

	mount -t overlay overlay -o lowerdir=/,upperdir=/mnt/overlay/upper,workdir=/mnt/overlay/work /mnt/overlay/merged
	mkdir /mnt/overlay/merged/old_root

	cd /mnt/overlay/merged
	pivot_root . old_root
	cd /
	mount --move /old_root/sys /sys
	mount --move /old_root/proc /proc
	mount --move /old_root/dev /dev
	umount -l /old_root
	rmdir /old_root
fi

if [ "$skip_gadget" != 1 ]; then
	modprobe libcomposite

	cd /sys/kernel/config/usb_gadget/
	mkdir g1
	cd g1/

	echo 0x1d6b > idVendor
	echo 0x1000 > idProduct
	mkdir strings/0x409
	echo 0000000000 > strings/0x409/serialnumber
	echo Linux > strings/0x409/manufacturer
	echo libcomposite > strings/0x409/product

	mkdir configs/c.1
	mkdir functions/acm.0
	ln -s functions/acm.0/ configs/c.1/

	ls /sys/class/udc/ > UDC
fi

mount LABEL=boot /mnt/boot || true

mount -t squashfs /dev/mtdblock2 /mnt/firmware
modprobe sprdwl_ng

exec /sbin/init
