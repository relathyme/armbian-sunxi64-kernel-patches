#!/bin/sh

mount -t sysfs sysfs -o nosuid,nodev,noexec /sys
mount -t proc proc -o nosuid,nodev,noexec /proc

skip_overlay=0

if [ "$skip_overlay" != 1 ]; then
	mount -t tmpfs tmpfs /mnt/overlay
	mkdir -p /mnt/overlay/upper /mnt/overlay/work /mnt/overlay/merged

	mount -t overlay overlay -o lowerdir=/,upperdir=/mnt/overlay/upper,workdir=/mnt/overlay/work /mnt/overlay/merged
	mkdir /mnt/overlay/merged/old_root

	cd /mnt/overlay/merged
	pivot_root . old_root
	cd /
	mount --move /old_root/sys /sys
	mount --move /old_root/proc /proc
	mount --move /old_root/dev /dev
	mount -o ro,remount /old_root
fi

mount /dev/mtdblock2 /mnt/firmware
modprobe sprdwl_ng

exec /sbin/init
